  <eml>
    <P Name="name">f1</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">39</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function dTrad = f1(Trad, Tair, Tout_water, h_wr, A_wr, h, A, m_rad, c_rad)
    dTrad = ((Tout_water - Trad) * h_wr * A_wr - (Trad - Tair) * h * A) / (m_rad * c_rad);
end
