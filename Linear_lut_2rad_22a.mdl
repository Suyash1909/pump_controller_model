      <P Name="subviewer">217</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function h_wr = fcn(K, D, mdot, A)
Vm = mdot/(A * 24 * 1000);
Nu = 0.023 * (((1000*D*Vm)/0.001002)^0.8) * (6.9^0.4);
h_wr = (Nu * K)/D;
end
</P>
      </eml>
    </state>
    <data SSID="4" name="K">
      <P Name="scope">INPUT_DATA</P>
      <props>
