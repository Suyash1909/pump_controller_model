    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">289</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function Temp_out = fcn(Temp_in, power, maxPower)
dT = (power/maxPower)* 1.2;
Temp_out = dT + Temp_in;
end
</P>
      </eml>
    </state>
    <data SSID="4" name="Temp_in">
      <P Name="scope">INPUT_DATA</P>
