        <P Name="isEML">1</P>
        <P Name="script">function dTout_water = f3(Tout_water, T_in_water, Trad, mdot_w, c_w, h_wr, A_wr, m_w_rad)
    dTout_water = ((T_in_water - Tout_water) * mdot_w * c_w - (Tout_water - Trad) * h_wr * A_wr) / (m_w_rad * c_w);
end
</P>
