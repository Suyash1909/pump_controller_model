      <P Name="subviewer">236</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function dTair = f2(Trad, Tair, A, h, v_air, c_air, m_air, T_amb, rho_air)
    dTair = ((Trad - Tair) * h * A - (Tair - T_amb) * v_air * rho_air * A * c_air) / (m_air * c_air);
end
</P>
      </eml>
    </state>
