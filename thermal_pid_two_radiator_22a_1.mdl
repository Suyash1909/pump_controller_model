      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function h_ar = fcn(K, D, Va)
Nu = 0.664*((Va*D)/0.0000148)^0.5*(0.71)^0.33;
h_ar = (Nu * K)/D;
end
</P>
      </eml>
    </state>
    <data SSID="4" name="K">
      <P Name="scope">INPUT_DATA</P>
      <props>
